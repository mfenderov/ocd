{
  "name": "ocd-fleet-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=coverage",
    "crap": "node --experimental-strip-types tools/crap/cli.ts",
    "crap:self": "vitest run --config tools/vitest.config.ts --coverage && node --experimental-strip-types tools/crap/cli.ts -c tools/coverage/coverage-final.json --root tools --src . -max 10",
    "typecheck": "tsc --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1"
  }
}
